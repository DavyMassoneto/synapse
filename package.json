{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "validate": "npm run check && npm run typecheck && npm run check:build && npm test",
    "test": "npm run test:typed",
    "check:build": "node scripts/check-build.mjs",
    "test:typed": "node scripts/run-typed-tests.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "~1.5.0",
    "@earendil-works/pi-ai": "~1.5.0",
    "@earendil-works/pi-coding-agent": "~1.5.0",
    "@earendil-works/pi-tui": "~1.5.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "imports": {
    "#build-options": "./scripts/build-options.mjs"
  }
}

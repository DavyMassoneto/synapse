{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "pretest": "npm run build",
    "test": "vitest run",
    "evaluate": "tsx .github/pr-evaluator/main.ts",
    "validate": "npm run lint && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "~1.5.0",
    "@earendil-works/pi-ai": "~1.5.0",
    "@earendil-works/pi-coding-agent": "~1.5.0",
    "@earendil-works/pi-tui": "~1.5.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^22.20.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "tsx": "^4.23.15",
    "typebox": "^1.4.6",
    "vitest": "4.1.12"
  },
  "pi": {
    "extensions": [
      "./dist/entry.js"
    ]
  }
}

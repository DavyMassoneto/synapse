{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": false,
    "noEmitOnError": true,
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "src/package.json"],
  "exclude": ["src/**/*.test.ts", "src/modules/*/tests/**"]
}

{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!**/*.md"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "plugins": [
    "./biome/no-unknown.grit",
    "./biome/no-object-type.grit",
    "./biome/no-inline-object-type.grit",
    "./biome/no-inline-function-type.grit",
    "./biome/no-index-signature.grit",
    "./biome/no-inline-composite-type.grit",
    "./biome/no-record.grit",
    "./biome/no-map-as-record.grit",
    "./biome/no-type-assertion.grit",
    "./biome/no-type-guard.grit",
    "./biome/no-untyped-collection.grit",
    "./biome/no-untyped-parameter.grit",
    "./biome/no-untyped-property.grit",
    "./biome/no-import-extension.grit",
    "./biome/no-index-import.grit",
    "./biome/no-deep-relative-import.grit",
    "./biome/no-nested-function.grit",
    "./biome/no-fallback.grit",
    "./biome/no-default-values.grit",
    "./biome/predicate-naming.grit",
    "./biome/no-any-from-library.grit",
    "./biome/no-empty-return.grit",
    "./biome/no-return-undefined.grit",
    "./biome/no-undefined-type.grit",
    "./biome/no-undefined-comparison.grit",
    "./biome/no-empty-interface.grit",
    "./biome/private-member-prefix.grit"
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 30,
            "skipBlankLines": true
          }
        },
        "noBannedTypes": "error"
      },
      "nursery": {
        "noUnsafeReturn": "error"
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 200,
            "skipBlankLines": true
          }
        },
        "noInferrableTypes": "error",
        "noMagicNumbers": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "assert": "Tests use expect from Vitest, not the Node assert.",
              "assert/strict": "Tests use expect from Vitest, not the Node assert.",
              "node:assert": "Tests use expect from Vitest, not the Node assert.",
              "node:assert/strict": "Tests use expect from Vitest, not the Node assert."
            }
          }
        },
        "useBlockStatements": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useImportType": {
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        }
      },
      "suspicious": {
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noImplicitAnyLet": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        },
        "noTsIgnore": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/tests/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.ts", "!**/*.d.ts", "!**/*.config.ts", "!**/tests/**", "!**/*.test.ts", "!**/types.ts"],
      "plugins": ["./biome/types-file.grit"]
    },
    {
      "includes": ["**/*.ts", "!**/*.d.ts", "!**/*.config.ts", "!**/tests/**", "!**/*.test.ts", "!**/constants.ts"],
      "plugins": ["./biome/constants-file.grit"]
    },
    {
      "includes": ["**/index.ts", "!**/tests/**"],
      "plugins": ["./biome/index-reexports-only.grit"]
    },
    {
      "includes": ["**/*.ts", "!**/*.d.ts", "!**/*.config.ts", "!**/tests/**", "!**/*.test.ts"],
      "plugins": ["./biome/top-level-functions.grit", "./biome/no-function-with-class.grit"]
    },
    {
      "includes": ["**/*.ts", "!**/*.d.ts", "!**/*.config.ts", "!**/tests/**", "!**/*.test.ts", "!**/predicates.ts"],
      "plugins": ["./biome/predicates-file.grit"]
    },
    {
      "includes": ["**/predicates.ts", "!**/tests/**"],
      "plugins": ["./biome/only-predicates-file.grit"]
    },
    {
      "includes": ["**/*.js", "**/*.jsx", "**/*.mjs", "**/*.cjs"],
      "plugins": ["./biome/no-javascript-file.grit"]
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}

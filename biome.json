{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": ["**", "!dist", "!docs", "!**/*.md"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useBlockStatements": "error",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**", "../**"],
                "message": "Use o alias @/"
              }
            ]
          }
        }
      },
      "nursery": {
        "noUnsafeTypeAssertion": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": ["./biome-rules/no-unknown.grit", "./biome-rules/no-const-assertion.grit"],
  "overrides": [
    {
      "includes": ["src/modules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "Use o alias @/"
                  },
                  {
                    "group": [
                      "@earendil-works/**",
                      "@/composition",
                      "@/integration",
                      "@/integration/**",
                      "@/modules"
                    ],
                    "message": "Depend\u00eancia fora da fronteira do m\u00f3dulo"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/integration/**", "src/composition/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "Use o alias @/"
                  },
                  {
                    "group": [
                      "@/modules/*/internal",
                      "@/modules/*/internal/**",
                      "@/modules/*/adapters",
                      "@/modules/*/adapters/**"
                    ],
                    "message": "Acesso a \u00e1rea privada do m\u00f3dulo"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
